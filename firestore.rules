rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() {
      return signedIn() && request.auth.token.email == 'ahaan@tintinopedia.com'
        && request.auth.token.email_verified == true;
    }
    function meRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(meRef()) && get(meRef()).data.status == 'approved'; }
    function can(p) { return isSuper() || (approved() && p in get(meRef()).data.permissions); }
    function canAny(ps) { return isSuper() || (approved() && get(meRef()).data.permissions.hasAny(ps)); }
    function adminPerms() {
      return ['users.approve','users.delete','users.create','roles.add','roles.edit','roles.delete',
              'perms.add','perms.edit','perms.delete','perms.deactivate'];
    }

    function myEmail() { return request.auth.token.email.lower(); }
    function inviteRef() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function profileKeys() {
      return ['fullName','onFieldName','photoURL','skill','battingStyle','bowlingStyle','age','updatedAt'];
    }

    // Private account records (email, status, roles, permissions)
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || canAny(adminPerms().concat(['users.edit']));
      allow create: if signedIn() && request.auth.uid == uid && (
        // normal Google sign-up
        (request.resource.data.status == 'new' && request.resource.data.isSuperAdmin == false
          && request.resource.data.roles.size() == 0 && request.resource.data.permissions.size() == 0)
        || isSuper()
        // user pre-created by an admin: must match the invite exactly
        || (request.auth.token.email_verified == true && exists(inviteRef())
          && request.resource.data.status == 'approved' && request.resource.data.isSuperAdmin == false
          && request.resource.data.roles == get(inviteRef()).data.roles
          && request.resource.data.permissions == get(inviteRef()).data.permissions
          && request.resource.data.playerId == get(inviteRef()).data.playerId));
      allow update: if
        // a user editing their own profile; can only move new/rejected -> pending
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               profileKeys().concat(['status','submittedAt','lastLoginAt','displayName','googlePhoto']))
          && (request.resource.data.status == resource.data.status
              || (resource.data.status in ['new','rejected'] && request.resource.data.status == 'pending')))
        || isSuper()
        || (canAny(adminPerms())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status','roles','permissions','approvedAt','approvedBy']))
        || (can('users.edit') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys()));
      allow delete: if can('users.delete');
    }

    // Users created manually by admins, waiting for their first Google sign-in (doc id = lower-case email)
    match /invites/{email} {
      allow read: if (signedIn() && myEmail() == email) || canAny(['users.create','users.delete','users.edit']);
      allow create: if can('users.create');
      allow update: if canAny(adminPerms().concat(['users.edit']));
      allow delete: if canAny(['users.create','users.delete']) || (signedIn() && myEmail() == email);
    }

    // Public player profiles
    match /players/{pid} {
      allow read: if true;
      allow create, update: if canAny(['users.approve','users.create','users.edit','teams.manage'])
        || (approved() && get(meRef()).data.get('playerId', request.auth.uid) == pid);
      allow delete: if can('users.delete');
    }

    match /roles/{rid} {
      allow read: if signedIn();
      allow create: if can('roles.add');
      allow update: if canAny(['roles.edit','perms.add','perms.edit','perms.delete','perms.deactivate']);
      allow delete: if can('roles.delete');
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if can('teams.manage');
    }

    match /tournaments/{id} {
      allow read: if true;
      allow write: if can('tournaments.manage');
    }

    match /matches/{mid} {
      allow read: if true;
      allow create, delete: if can('tournaments.manage');
      allow update: if canAny(['tournaments.manage','score.update','score.edit','score.delete','playingxi.manage']);

      match /balls/{bid} {
        allow read: if true;
        allow create: if can('score.update');
        allow update: if canAny(['score.edit','commentary.update','commentary.delete']);
        allow delete: if can('score.delete');
      }
    }

    // collection-group reads for player statistics
    match /{path=**}/balls/{bid} {
      allow read: if true;
    }

    match /news/{id} {
      allow read: if true;
      allow create: if request.resource.data.kind == 'blog' ? can('blogs.add') : can('news.add');
      allow update, delete: if canAny(['news.add','blogs.add']);
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if can('videos.add');
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if can('photos.add');
    }
  }
}
